generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoReparacion {
  EN_REVISION
  EN_REPARACION
  TERMINADO
  ENTREGADO
  FACTURADO
  PAGADO
}

enum TipoUbicacion {
  RECEPCION
  ESTACIONAMIENTO
  BAHIA
  ELEVADOR
  FOSO
  DIAGNOSTICO
  ALINEACION
  NEUMATICOS
  LUBRICACION
  ELECTRICIDAD
  CHAPA_PINTURA
  LAVADO
  TERMINADOS
  OTRO
}

enum PlanEmpresa {
  NORMAL
  PREMIUM
}

model Empresa {
  id        Int        @id @default(autoincrement())
  nombre    String
  activa    Boolean    @default(true)
  plan      PlanEmpresa @default(NORMAL)
  createdAt DateTime   @default(now()) @map("created_at")

  usuarios    Usuario[]
  clientes    Cliente[]
  piezas      Pieza[]
  servicios   Servicio[]
  ubicaciones Ubicacion[]

  @@map("empresas")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  rut       String?
  email     String?
  telefono  String?  @map("telefono")
  direccion String?  @map("direccion")
  empresaId Int      @map("empresa_id")

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  vehiculos Vehiculo[]
  facturas  Factura[]

  @@unique([email, empresaId])
  @@map("clientes")
}

model Vehiculo {
  id          Int     @id @default(autoincrement())
  marca       String
  modelo      String
  anio        Int?    @map("anio")
  patente     String
  kilometraje Int?    @map("kilometraje")
  clienteId   Int     @map("cliente_id")

  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  reparaciones Reparacion[]

  @@unique([patente, clienteId])
  @@map("vehiculos")
}

model Reparacion {
  id                 Int             @id @default(autoincrement())
  descripcion        String
  problemaReportado  String?         @map("problema_reportado")
  diagnostico        String?
  trabajosRealizados String?         @map("trabajos_realizados")
  fechaEntrada       DateTime        @default(now()) @map("fecha_entrada")
  fechaSalida     DateTime?       @map("fecha_salida")
  estado          EstadoReparacion @default(EN_REVISION)
  costoManoObra   Float           @default(0.0) @map("costo_mano_obra")
  vehiculoId      Int             @map("vehiculo_id")
  mecanicoId      Int?            @map("mecanico_id")
  recepcionistaId Int             @map("recepcionista_id")
  ubicacionId     Int?            @map("ubicacion_id")

  vehiculo        Vehiculo        @relation(fields: [vehiculoId], references: [id])
  mecanico        Mecanico?       @relation(fields: [mecanicoId], references: [id])
  recepcionista   Usuario         @relation("reparacion_recepcionista", fields: [recepcionistaId], references: [id])
  ubicacion       Ubicacion?      @relation(fields: [ubicacionId], references: [id])

  detalleReparacion DetalleReparacion[]
  servicios         ReparacionServicio[]
  facturas          Factura[]
  movimientos       MovimientoUbicacion[]

  @@map("reparaciones")
}

model DetalleReparacion {
  id            Int     @id @default(autoincrement())
  reparacionId  Int     @map("reparacion_id")
  piezaId       Int     @map("pieza_id")
  cantidad      Int     @default(1)
  precioUnitario Float   @map("precio_unitario")
  descripcion   String?

  reparacion    Reparacion @relation(fields: [reparacionId], references: [id], onDelete: Cascade)
  pieza         Pieza      @relation(fields: [piezaId], references: [id])

  @@unique([reparacionId, piezaId])
  @@map("detalle_reparacion")
}

model Pieza {
  id       Int    @id @default(autoincrement())
  nombre   String
  marca    String?
  precio   Float
  stock    Int    @default(0)
  codigo   String
  empresaId Int   @map("empresa_id")

  empresa      Empresa           @relation(fields: [empresaId], references: [id])
  detalleReparacion DetalleReparacion[]

  @@unique([codigo, empresaId])
  @@map("piezas")
}

model Factura {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now())
  total         Float
  clienteId     Int      @map("cliente_id")
  reparacionId  Int      @map("reparacion_id")

  cliente       Cliente    @relation(fields: [clienteId], references: [id])
  reparacion    Reparacion @relation(fields: [reparacionId], references: [id])
  pagos         Pago[]

  @@map("facturas")
}

model Pago {
  id        Int      @id @default(autoincrement())
  facturaId Int      @map("factura_id")
  fecha     DateTime @default(now())
  monto     Float
  metodo    String
  nota      String?
  createdAt DateTime @default(now()) @map("created_at")

  factura   Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@map("pagos")
}

model Servicio {
  id                 Int      @id @default(autoincrement())
  nombre             String
  descripcion        String?
  problemaReportado  String?  @map("problema_reportado")
  diagnostico        String?
  trabajosRealizados String?  @map("trabajos_realizados")
  precioBase         Float    @default(0.0) @map("precio_base")
  activo             Boolean  @default(true)
  empresaId          Int      @map("empresa_id")

  empresa             Empresa              @relation(fields: [empresaId], references: [id])
  reparacionServicios ReparacionServicio[]

  @@map("servicios")
}

model ReparacionServicio {
  id             Int   @id @default(autoincrement())
  reparacionId   Int   @map("reparacion_id")
  servicioId     Int   @map("servicio_id")
  cantidad       Int   @default(1)
  precioUnitario Float @map("precio_unitario")

  reparacion Reparacion @relation(fields: [reparacionId], references: [id], onDelete: Cascade)
  servicio   Servicio   @relation(fields: [servicioId], references: [id])

  @@unique([reparacionId, servicioId])
  @@map("reparacion_servicio")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String
  passwordHash String   @map("password_hash")
  nombre       String
  activo       Boolean  @default(true)
  loginAttempts Int     @default(0) @map("login_attempts")
  lockedUntil  DateTime? @map("locked_until")
  rolId        Int      @map("rol_id")
  empresaId    Int      @map("empresa_id")

  rol          Rol      @relation(fields: [rolId], references: [id])
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
  mecanico     Mecanico?
  reparacionesRecepcionista Reparacion[] @relation("reparacion_recepcionista")

  @@unique([email, empresaId])
  @@map("usuarios")
}

model Rol {
  id       Int    @id @default(autoincrement())
  nombre   String @unique
  permisos Json

  usuarios Usuario[]
  @@map("roles")
}

model Mecanico {
  id           Int     @id @default(autoincrement())
  usuarioId    Int     @unique @map("usuario_id")
  especialidad String?

  usuario      Usuario @relation(fields: [usuarioId], references: [id])
  reparaciones Reparacion[]

  @@map("mecanicos")
}

model Ubicacion {
  id        Int           @id @default(autoincrement())
  nombre    String
  tipo      TipoUbicacion @default(OTRO)
  orden     Int           @default(0)
  activo    Boolean       @default(true)
  empresaId Int           @map("empresa_id")

  empresa      Empresa               @relation(fields: [empresaId], references: [id])
  reparaciones Reparacion[]
  movimientos  MovimientoUbicacion[]

  @@unique([nombre, empresaId])
  @@map("ubicaciones")
}

model MovimientoUbicacion {
  id              Int      @id @default(autoincrement())
  reparacionId    Int      @map("reparacion_id")
  ubicacionId     Int?     @map("ubicacion_id")
  ubicacionNombre String?  @map("ubicacion_nombre")
  usuarioId       Int?     @map("usuario_id")
  nota            String?
  fecha           DateTime @default(now())

  reparacion Reparacion @relation(fields: [reparacionId], references: [id], onDelete: Cascade)
  ubicacion  Ubicacion? @relation(fields: [ubicacionId], references: [id])

  @@map("movimiento_ubicacion")
}