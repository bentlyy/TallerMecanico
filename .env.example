# Environment variables for Taller Mecanico
# Copy this file to .env and fill in your values

DATABASE_URL="postgresql://${DB_USER:-taller_user}:${DB_PASSWORD:-taller_password}@${DB_HOST:-127.0.0.1}:5432/${DB_NAME:-taller_db}?schema=public"
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3043
LOG_LEVEL=info
API_VERSION=v1

# SSO con el Core (identidad central). El taller ya no tiene login propio.
# Pedí el secreto con: npm run sso:secret -w @amg/platform -- taller
CORE_URL=https://amgdeveloper.cl
APP_URL=https://taller.amgdeveloper.cl
AMG_SSO_CLIENT_ID=taller
AMG_SSO_CLIENT_SECRET=cambiame-secreto-derivado-por-el-core
